{
  "expo": {
    "name": "KuryenTipid",
    "slug": "kuryentipid",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kuryentipid",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EA580C"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      ["expo-image-picker", {
        "photosPermission": "Allow KuryenTipid to select a meter photo for reading.",
        "cameraPermission": "Allow KuryenTipid to photograph your electric meter.",
        "microphonePermission": false
      }]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
